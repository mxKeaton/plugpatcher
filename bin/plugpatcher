#!/usr/bin/env bash
#
# plugpatcher — patch Omarchy shell plugins in a git repo, pull upstream updates
# in with your edits on top, and send them back; the original keeps updating.
#
#   original plugin   ~/.config/omarchy/plugins/<id>          (pristine install, left in place)
#   per-project repo  ~/.local/share/plugpatcher/<id>/        (git clone of upstream + your branches)
#   generated clone   ~/.config/omarchy/plugins/local.<seg>/  (what the shell loads)
#
# The clone carries `omarchy.clonedFrom = <id>`, so the shell routes the
# original's IPC/service calls to the clone and switches the bar/layout to it —
# the same convention `omarchy plugin clone` uses, which it only offers for
# first-party plugins. PlugPatcher does it for any plugin.
#
# Commands:
#   list                 installed plugins and their edit state
#   status <id>          details for one plugin
#   setup <id> [url]     start editing (clone upstream into a per-project repo)
#   sync <id>            pull upstream into the repo (rebase) and regenerate the clone
#   pr <id> [ai|manual]  open a PR (ai writes the text; manual opens GitHub's form)
#   revert <id>          stop editing: restore the original, delete the repo
#   open <id>            launch the system default agent in the repo, resuming its session
#   files <id>           open the patch folder in the default file manager
#   editor <id>          open the patch folder in the default editor
#   help                 this text

set -euo pipefail

VERSION="0.1.0"

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
PLUGINS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/plugpatcher"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/plugpatcher"
AGENT_FILE="$HOME/.config/omarchy/defaults/agent"
CATALOG="$DATA_DIR/catalog.json"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/plugpatcher/config.json"

# Extra `git -c` args used when the user has no identity configured, so internal
# rebases/commits never fail on a machine where Omarchy's git setup was skipped.
GIT_ID=()
git_identity() {
  if git config user.email >/dev/null 2>&1 && git config user.name >/dev/null 2>&1; then
    GIT_ID=()
  else
    GIT_ID=(-c user.name="${GIT_AUTHOR_NAME:-PlugPatcher}" -c user.email="${GIT_AUTHOR_EMAIL:-plugpatcher@localhost}")
  fi
}

# --------------------------------------------------------------------- output

log()  { printf 'plugpatcher: %s\n' "$*" >&2; }
warn() { printf 'plugpatcher: warning: %s\n' "$*" >&2; }
die()  { printf 'plugpatcher: error: %s\n' "$*" >&2; exit 1; }

notify() { # summary body
  command -v omarchy-notification-send >/dev/null 2>&1 || return 0
  omarchy-notification-send -g "PlugPatcher" "$1" "${2:-}" >/dev/null 2>&1 || true
}

need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# ---------------------------------------------------------------------- paths

plugin_dir() { printf '%s/%s' "$PLUGINS_DIR" "$1"; }
repo_dir()   { printf '%s/%s' "$DATA_DIR" "$1"; }
meta_file()  { printf '%s/%s.json' "$DATA_DIR" "$1"; }
log_file()   { printf '%s/%s.log' "$STATE_DIR" "$1"; }

is_setup() { [[ -f "$(meta_file "$1")" ]]; }

# Print the per-project repo path, or fail with a clear, actionable message.
require_repo() {
  local repo; repo="$(repo_dir "$1")"
  [[ -d "$repo" ]] || die "patch folder not found: $repo (re-run: plugpatcher setup $1)"
  printf '%s' "$repo"
}

edit_id_of() { # read from metadata
  jq -r '.editId' "$(meta_file "$1")"
}

manifest_path() { # id -> path to manifest.json (user plugin first, then catalog)
  local id="$1" d
  d="$(plugin_dir "$id")"
  if [[ -f "$d/manifest.json" ]]; then
    printf '%s' "$d/manifest.json"
    return 0
  fi
  omarchy-plugin-catalog 2>/dev/null |
    jq -r --arg id "$id" '.[] | select(.id == $id) | .manifestPath' | head -1
}

# Last dotted segment, sanitized to a legal plugin id fragment.
edit_id_for() {
  local source_id="$1" seg
  seg="${source_id##*.}"
  seg="${seg//[^A-Za-z0-9._-]/}"
  [[ -n "$seg" ]] || seg="$source_id"
  local candidate="local.$seg"
  # Collision with a different plugin already owning that clone id.
  if [[ -d "$(plugin_dir "$candidate")" ]] && \
     { [[ ! -f "$(meta_file "$candidate")" ]] || [[ "$(jq -r '.sourceId' "$(meta_file "$candidate")" 2>/dev/null)" != "$source_id" ]]; }; then
    candidate="local.$seg-$(printf '%s' "$source_id" | md5sum | cut -c1-4)"
  fi
  printf '%s' "$candidate"
}

upstream_url_of() {
  local d; d="$(plugin_dir "$1")"
  [[ -d "$d/.git" ]] || return 1
  git -C "$d" remote get-url origin 2>/dev/null
}

# Best-known source URL for any installed plugin: the PlugPatcher upstream when
# it is adopted, else the plugin's own git origin, else a homepage/repository
# field in its manifest.
source_url_of() { # id
  local id="$1" mf d mp url
  mf="$(meta_file "$id")"
  if [[ -f "$mf" ]]; then
    url="$(jq -r '.upstream // empty' "$mf" 2>/dev/null || true)"
    [[ -n "$url" ]] && { printf '%s' "$url"; return 0; }
  fi
  d="$(plugin_dir "$id")"
  if [[ -d "$d/.git" ]]; then
    url="$(git -C "$d" remote get-url origin 2>/dev/null || true)"
    [[ -n "$url" ]] && { printf '%s' "$url"; return 0; }
  fi
  mp="$(manifest_path "$id" 2>/dev/null || true)"
  if [[ -n "$mp" && -f "$mp" ]]; then
    url="$(jq -r '.homepage // .repository // empty' "$mp" 2>/dev/null || true)"
    [[ -n "$url" ]] && { printf '%s' "$url"; return 0; }
  fi
  return 1
}

repo_default_branch() { # repo -> upstream branch name
  local repo="$1"
  git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' && return 0
  if git -C "$repo" show-ref --verify --quiet refs/remotes/origin/main; then echo main; return 0; fi
  if git -C "$repo" show-ref --verify --quiet refs/remotes/origin/master; then echo master; return 0; fi
  echo master
}

rescan() { omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true; }

# Make sure the generated clone — not the original — is the plugin being loaded.
# Heals the state if the original was removed/reinstalled underneath us.
# Point the shell at a bar plugin, restarting only when it actually changes.
# Flipping .bar.id does not reliably rebuild the bar host (which can leave no
# bar on screen), so restart the shell; detached, so the reload killing this
# process cannot abort it.
# Restart the shell, detached as a transient user unit (a child of this process
# would be killed by the shell's own reload). Used to make a regenerated clone
# actually rebuild in the bar/panel.
schedule_shell_restart() {
  if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --user --collect --quiet --unit="plugpatcher-restart-$RANDOM" \
      bash -c 'sleep 0.8; omarchy restart shell' >/dev/null 2>&1 || true
  else
    setsid bash -c 'sleep 0.8; omarchy restart shell' >/dev/null 2>&1 &
  fi
}

set_bar() { # target bar plugin id
  local target="$1" config current
  config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
  current="$(jq -r '.bar.id // empty' "$config" 2>/dev/null || true)"
  [[ "$current" == "$target" ]] && return 0

  # Schedule the restart FIRST: `omarchy bar use` reloads plugins and can kill
  # this process before it reaches any later line.
  schedule_shell_restart
  omarchy bar use "$target" >/dev/null 2>&1 || true
}

ensure_active() { # source-id
  local id="$1" mf edit_id kinds want
  mf="$(meta_file "$id")"
  [[ -f "$mf" ]] || return 0
  # Respect an explicit switch to the original: do not force the clone back on.
  want="$(jq -r '.want // "patched"' "$mf" 2>/dev/null || echo patched)"
  [[ "$want" == "original" ]] && return 0
  edit_id="$(jq -r '.editId' "$mf" 2>/dev/null || true)"
  [[ -n "$edit_id" ]] || return 0
  kinds="$(jq -r '(.kinds // []) | join(",")' "$(manifest_path "$id")" 2>/dev/null || true)"
  if [[ ",$kinds," == *",bar,"* ]]; then
    set_bar "$edit_id"
    omarchy plugin disable "$id" >/dev/null 2>&1 || true
  else
    omarchy plugin enable "$edit_id" >/dev/null 2>&1 || true
  fi
}

# Record the moment a plugin was last pulled from upstream.
touch_last_sync() {
  local mf; mf="$(meta_file "$1")"
  [[ -f "$mf" ]] || return 0
  local tmp; tmp="$(mktemp)"
  if jq --argjson t "$(date +%s)" '.lastSync = $t' "$mf" > "$tmp"; then
    mv "$tmp" "$mf"
  else
    rm -f "$tmp"
  fi
}

# Remember which side the user chose to load (patched|original).
touch_want() {
  local mf; mf="$(meta_file "$1")"
  [[ -f "$mf" ]] || return 0
  local tmp; tmp="$(mktemp)"
  if jq --arg w "$2" '.want = $w' "$mf" > "$tmp"; then
    mv "$tmp" "$mf"
  else
    rm -f "$tmp"
  fi
}

# Set an arbitrary key in a plugin's metadata.
meta_set() { # id key value
  local mf; mf="$(meta_file "$1")"
  [[ -f "$mf" ]] || return 0
  local tmp; tmp="$(mktemp)"
  if jq --arg k "$2" --arg v "$3" '.[$k] = $v' "$mf" > "$tmp"; then
    mv "$tmp" "$mf"
  else
    rm -f "$tmp"
  fi
}

wait_discovered() { # id
  local id="$1" i
  for (( i = 0; i < 60; i++ )); do
    if omarchy-plugin-list --json 2>/dev/null | jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.05
  done
  return 1
}

# ------------------------------------------------------------- clone generation

# Build ~/.config/omarchy/plugins/<editId> from the repo's branch, rewriting the
# manifest so the clone coexists with the original and routes back to it.
generate_clone() {
  local id="$1"
  local mf repo branch edit_id source_id name display
  mf="$(meta_file "$id")"
  repo="$(repo_dir "$id")"
  branch="$(jq -r '.branch' "$mf")"
  edit_id="$(jq -r '.editId' "$mf")"
  source_id="$(jq -r '.sourceId' "$mf")"
  name="$(jq -r '.name // empty' "$mf")"
  [[ -n "$name" ]] || name="$source_id"
  display="My $name"

  [[ -d "$repo/.git" ]] || die "no repository at $repo"
  git -C "$repo" rev-parse --verify --quiet "$branch" >/dev/null || die "branch '$branch' is missing in $repo"

  local tmp; mkdir -p "$PLUGINS_DIR"; tmp="$(mktemp -d "$PLUGINS_DIR/.plugpatcher-gen.XXXXXX")"
  trap 'rm -rf "$tmp"' RETURN

  git -C "$repo" archive "$branch" | tar -x -C "$tmp"
  [[ -f "$tmp/manifest.json" ]] || die "branch '$branch' has no manifest.json"

  jq --arg id "$edit_id" --arg name "$display" --arg src "$source_id" '
    .id = $id
    | .name = $name
    | (if (.barWidget | type) == "object" then .barWidget.displayName = $name else . end)
    | .omarchy = ((if (.omarchy | type) == "object" then .omarchy else {} end) + {clonedFrom: $src})
    | del(.omarchy.clonePaths)
    | .plugpatcher = {generated: true, sourceId: $src}
  ' "$tmp/manifest.json" > "$tmp/manifest.json.tmp"
  mv "$tmp/manifest.json.tmp" "$tmp/manifest.json"

  # No symlinks may survive into the plugin tree (omarchy-plugin-validate).
  local link; link="$(find "$tmp" -type l -print -quit 2>/dev/null || true)"
  if [[ -n "$link" ]]; then
    warn "upstream contains a symlink ($link); dereferencing copies"
    # Replace symlinks with their targets where possible.
    while IFS= read -r -d '' l; do
      if [[ -e "$l" ]]; then
        local c; c="$(readlink -f "$l")"
        rm -f "$l"; cp -a "$c" "$l"
      else
        rm -f "$l"
      fi
    done < <(find "$tmp" -type l -print0)
  fi

  local target; target="$(plugin_dir "$edit_id")"
  # Keep temp/old out of the plugins dir glob (dot-prefixed) so the shell's scan
  # never sees a second directory claiming the same plugin id.
  local old="$PLUGINS_DIR/.${edit_id}.plugpatcher-old.$$"
  rm -rf "$old"
  [[ -e "$target" ]] && mv "$target" "$old"
  mv "$tmp" "$target"
  rm -rf "$old"
  trap - RETURN
  log "generated $edit_id"
}

# ------------------------------------------------------------------- setup flow

cmd_setup() {
  local id="${1:-}" upstream="${2:-}"
  [[ -n "$id" ]] || die "usage: plugpatcher setup <plugin-id> [upstream-git-url]"
  local pd; pd="$(plugin_dir "$id")"
  [[ -f "$pd/manifest.json" ]] || die "'$id' is not installed at $pd"
  is_setup "$id" && die "'$id' is already set up for editing (editId: $(edit_id_of "$id"))"
  need git; need jq

  local first_party=false
  [[ "$id" == omarchy.* ]] && first_party=true

  if [[ -z "$upstream" ]]; then
    upstream="$(upstream_url_of "$id" || true)"
  fi
  if [[ "$first_party" == false && -z "$upstream" ]]; then
    die "'$id' has no git origin; re-run: plugpatcher setup '$id' <upstream-git-url>"
  fi

  local name kinds edit_id repo
  name="$(jq -r '.name // .id' "$pd/manifest.json")"
  kinds="$(jq -r '(.kinds // []) | join(",")' "$pd/manifest.json")"
  edit_id="$(edit_id_for "$id")"
  repo="$(repo_dir "$id")"

  mkdir -p "$DATA_DIR" "$STATE_DIR"

  local upstream_branch=""
  if [[ "$first_party" == true && -z "$upstream" ]]; then
    local stock
    stock="$(omarchy-plugin-catalog | jq -r --arg id "$id" '.[] | select(.id==$id) | .sourceDir' | head -1)"
    [[ -d "$stock" ]] || die "cannot locate the stock source for '$id'"
    rm -rf "$repo"; mkdir -p "$repo"
    cp -a "$stock/." "$repo/"; rm -rf "$repo/.git"
    git -C "$repo" init -q
    git -C "$repo" add -A
    git -C "$repo" -c user.name=plugpatcher -c user.email=plugpatcher@localhost \
      commit -qm "PlugPatcher: stock snapshot of $id"
    upstream="(stock)"
    upstream_branch="(none)"
  else
    if [[ -d "$repo/.git" ]]; then
      git -C "$repo" fetch -q origin
    else
      git clone -q -- "$upstream" "$repo"
    fi
    upstream_branch="$(repo_default_branch "$repo")"
  fi

  local branch="local"
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo" checkout -q "$branch"
  elif [[ -n "$upstream_branch" && "$upstream_branch" != "(none)" ]]; then
    git -C "$repo" checkout -q -B "$branch" "origin/$upstream_branch"
  else
    git -C "$repo" checkout -q -B "$branch"
  fi

  # Capture whatever the live plugin dir currently holds as the first change.
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete --exclude '.git' "$pd/" "$repo/"
  else
    while IFS= read -r -d '' f; do
      rel="${f#"$pd"/}"
      [[ "$rel" == .git/* || "$rel" == .git ]] && continue
      mkdir -p "$repo/$(dirname "$rel")"
      cp -a "$f" "$repo/$rel"
    done < <(find "$pd" -mindepth 1 -print0)
  fi
  git -C "$repo" add -A
  if ! git -C "$repo" diff --cached --quiet; then
    git -C "$repo" -c user.name="${GIT_AUTHOR_NAME:-PlugPatcher}" \
      -c user.email="${GIT_AUTHOR_EMAIL:-plugpatcher@localhost}" \
      commit -qm "PlugPatcher: capture current edits"
    log "captured the current state of '$id' as the first change"
  fi

  jq -n \
    --arg sourceId "$id" \
    --arg editId "$edit_id" \
    --arg name "$name" \
    --arg upstream "$upstream" \
    --arg upstreamBranch "$upstream_branch" \
    --arg branch "$branch" \
    --argjson firstParty "$first_party" \
    --arg createdAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson lastSync "$(date +%s)" \
    --arg want "patched" \
    '{version:1, sourceId:$sourceId, editId:$editId, name:$name, upstream:$upstream,
      upstreamBranch:$upstreamBranch, branch:$branch, firstParty:$firstParty,
      createdAt:$createdAt, lastSync:$lastSync, want:$want}' > "$(meta_file "$id")"

  generate_clone "$id"
  rescan

  if ! wait_discovered "$edit_id"; then
    warn "clone '$edit_id' was not discovered by the shell yet"
  fi
  ensure_active "$id"

  write_catalog >/dev/null 2>&1 || true
  notify "PlugPatcher: editing $name" "Active as $edit_id"
  log "editing '$id' → clone '$edit_id'"
  log "repo: $repo"
}

# ------------------------------------------------------------------- adopt flow

# Guess a git working copy for an installed plugin that is not yet set up.
adopt_find_repo() { # id -> path on stdout, or nothing
  local id="$1" d cand seg base
  d="$(plugin_dir "$id")"
  [[ -d "$d/.git" ]] && { printf '%s' "$d"; return 0; }
  seg="${id##*.}"
  for cand in "$HOME/Projects"/*/; do
    [[ -d "$cand/.git" ]] || continue
    if [[ -f "$cand/manifest.json" ]] && \
       [[ "$(jq -r '.id // empty' "$cand/manifest.json" 2>/dev/null)" == "$id" ]]; then
      printf '%s' "${cand%/}"; return 0
    fi
  done
  for cand in "$HOME/Projects"/*/; do
    [[ -d "$cand/.git" ]] || continue
    base="$(basename "${cand%/}")"
    [[ "${base,,}" == "${seg,,}" ]] && { printf '%s' "${cand%/}"; return 0; }
  done
  return 1
}

# List adoptable plugins as: id<TAB>repo<TAB>branch
adopt_candidates() {
  local d id repo branch
  for d in "$PLUGINS_DIR"/*/; do
    [[ -f "$d/manifest.json" ]] || continue
    id="$(jq -r '.id // empty' "$d/manifest.json" 2>/dev/null || true)"
    [[ -n "$id" ]] || continue
    [[ "$id" == local.* ]] && continue
    is_setup "$id" && continue
    repo="$(adopt_find_repo "$id" || true)"
    branch=""
    [[ -n "$repo" ]] && branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    printf '%s\t%s\t%s\n' "$id" "$repo" "$branch"
  done
}

adopt_interactive() {
  printf 'PlugPatcher — adopt an existing plugin project\n\n'
  local lines; lines="$(adopt_candidates)"
  [[ -n "$lines" ]] || die "no installed plugins are available to adopt"
  local -a ids=(); local i=0 id repo branch answer
  while IFS=$'\t' read -r id repo branch; do
    [[ -n "$id" ]] || continue
    ids+=("$id"); i=$((i+1))
    if [[ -n "$repo" ]]; then
      printf '  %d) %s\n       repo    %s\n       branch  %s\n' "$i" "$id" "$repo" "$branch"
    else
      printf '  %d) %s\n       repo    (none found)\n' "$i" "$id"
    fi
  done <<< "$lines"
  printf '\n'
  read -r -p "Adopt which? [1-$i]: " answer
  [[ "$answer" =~ ^[0-9]+$ ]] || die "invalid choice"
  id="${ids[$((answer-1))]:-}"
  [[ -n "$id" ]] || die "invalid choice"

  repo="$(adopt_find_repo "$id" || true)"
  if [[ -z "$repo" ]]; then
    read -r -p "Git working copy to adopt: " repo
    [[ -n "$repo" ]] || die "a repo path is required"
  fi
  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  read -r -p "Branch to adopt [$branch]: " answer
  [[ -n "$answer" ]] && branch="$answer"
  local upstream
  upstream="$(git -C "$repo" remote get-url upstream 2>/dev/null || git -C "$repo" remote get-url origin 2>/dev/null || true)"
  read -r -p "Upstream URL [$upstream]: " answer
  [[ -n "$answer" ]] && upstream="$answer"

  printf '\n  plugin    %s\n  repo      %s\n  branch    %s\n  upstream  %s\n\n' "$id" "$repo" "$branch" "$upstream"
  read -r -p "Proceed? [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]] || { printf 'cancelled\n'; return 0; }

  cmd_adopt "$id" --repo "$repo" --branch "$branch" --upstream "$upstream"
}

# Bring an existing git working copy under PlugPatcher: keep its history, make
# `local` the patched branch, and restore the installed original to pristine.
cmd_adopt() {
  local id="" repo="" branch="" upstream="" do_copy=false keep_original=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)          repo="${2:-}"; shift 2 ;;
      --branch)        branch="${2:-}"; shift 2 ;;
      --upstream)      upstream="${2:-}"; shift 2 ;;
      --copy)          do_copy=true; shift ;;
      --keep-original) keep_original=true; shift ;;
      -*) die "adopt: unknown option '$1'" ;;
      *)  if [[ -z "$id" ]]; then id="$1"; shift; else die "adopt: unexpected argument '$1'"; fi ;;
    esac
  done

  # No id: interactive wizard when we have a TTY, else reopen in a terminal.
  if [[ -z "$id" ]]; then
    if [[ -t 0 && -t 1 ]]; then adopt_interactive; return 0; fi
    if command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1; then
      log "opening a terminal to adopt a project"
      setsid omarchy-launch-floating-terminal-with-presentation "plugpatcher adopt" >/dev/null 2>&1 &
      return 0
    fi
    die "usage: plugpatcher adopt <plugin-id> [--repo PATH] [--branch NAME] [--upstream URL] [--copy] [--keep-original]"
  fi

  local pd; pd="$(plugin_dir "$id")"
  [[ -f "$pd/manifest.json" ]] || die "'$id' is not installed at $pd"
  is_setup "$id" && die "'$id' is already set up (editId: $(edit_id_of "$id"))"
  [[ "$id" == omarchy.* ]] && die "'$id' is first-party; use: plugpatcher setup $id"
  need git; need jq

  [[ -n "$repo" ]] || repo="$(adopt_find_repo "$id" || true)"
  [[ -n "$repo" && -d "$repo/.git" ]] || die "no git working copy found for '$id'; pass --repo <path>"
  repo="$(cd -- "$repo" && pwd)"

  if [[ -z "$branch" ]]; then
    branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    [[ -n "$branch" ]] || die "the working copy is on a detached HEAD; pass --branch <name>"
  fi
  git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" || \
    die "branch '$branch' was not found in $repo"

  if [[ -z "$upstream" ]]; then
    upstream="$(git -C "$repo" remote get-url upstream 2>/dev/null || true)"
    [[ -n "$upstream" ]] || upstream="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
    [[ -n "$upstream" ]] || die "cannot determine the upstream URL; pass --upstream <git-url>"
  fi

  local name kinds edit_id dest
  name="$(jq -r '.name // .id' "$pd/manifest.json")"
  kinds="$(jq -r '(.kinds // []) | join(",")' "$pd/manifest.json")"
  edit_id="$(edit_id_for "$id")"
  dest="$(repo_dir "$id")"
  mkdir -p "$DATA_DIR" "$STATE_DIR"
  [[ -e "$dest" ]] && die "'$dest' already exists"

  log "adopting '$id' from $repo"
  log "  branch:   $branch"
  log "  upstream: $upstream"

  if $do_copy; then
    cp -a -- "$repo" "$dest"
  else
    mv -- "$repo" "$dest"
  fi

  # Normalize remotes: origin must be the upstream PlugPatcher fetches from;
  # the fork (if any) is kept as plugpatcher-fork (pr recreates it anyway).
  if [[ "$(git -C "$dest" remote get-url origin 2>/dev/null || true)" == "$upstream" ]]; then
    :
  elif [[ "$(git -C "$dest" remote get-url upstream 2>/dev/null || true)" == "$upstream" ]]; then
    git -C "$dest" remote remove plugpatcher-fork >/dev/null 2>&1 || true
    git -C "$dest" remote rename origin plugpatcher-fork
    git -C "$dest" remote rename upstream origin
  else
    git -C "$dest" remote remove plugpatcher-fork >/dev/null 2>&1 || true
    git -C "$dest" remote rename origin plugpatcher-fork
    git -C "$dest" remote add origin "$upstream"
  fi
  git -C "$dest" fetch -q origin
  git -C "$dest" remote set-head origin --auto >/dev/null 2>&1 || true

  local upstream_branch; upstream_branch="$(repo_default_branch "$dest")"

  # The adopted work becomes the branch the clone is generated from.
  git -C "$dest" checkout -q -B local "$branch"

  # The installed original must be the pristine upstream again.
  if ! $keep_original; then
    local backup="$STATE_DIR/adopt-backup/${id}-$(date +%Y%m%d-%H%M%S)"
    if [[ -e "$pd" ]]; then
      mkdir -p "$(dirname "$backup")"
      mv -- "$pd" "$backup"
      log "backed up the previous install to $backup"
    fi
    mkdir -p "$pd"
    git -C "$dest" archive "origin/$upstream_branch" | tar -x -C "$pd"
    log "restored the original from origin/$upstream_branch"
  elif [[ ! -e "$pd" ]]; then
    warn "the original plugin dir is gone but --keep-original was set"
  fi

  jq -n \
    --arg sourceId "$id" \
    --arg editId "$edit_id" \
    --arg name "$name" \
    --arg upstream "$upstream" \
    --arg upstreamBranch "$upstream_branch" \
    --arg branch "local" \
    --argjson firstParty false \
    --arg createdAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson lastSync "$(date +%s)" \
    --arg want "patched" \
    '{version:1, sourceId:$sourceId, editId:$editId, name:$name, upstream:$upstream,
      upstreamBranch:$upstreamBranch, branch:$branch, firstParty:$firstParty,
      createdAt:$createdAt, lastSync:$lastSync, want:$want}' > "$(meta_file "$id")"

  generate_clone "$id"
  rescan

  if ! wait_discovered "$edit_id"; then
    warn "clone '$edit_id' was not discovered by the shell yet"
  fi
  ensure_active "$id"

  write_catalog >/dev/null 2>&1 || true
  notify "PlugPatcher: adopted $name" "Active as $edit_id"
  log "adopted '$id' → clone '$edit_id'"
  log "repo: $dest"
}

# -------------------------------------------------------------------- sync flow

cmd_sync() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: plugpatcher sync <plugin-id>"
  is_setup "$id" || die "'$id' is not set up (run: plugpatcher setup $id)"
  need git; need jq

  local mf repo branch ub upstream first_party
  mf="$(meta_file "$id")"
  repo="$(require_repo "$id")"
  branch="$(jq -r '.branch' "$mf")"
  ub="$(jq -r '.upstreamBranch' "$mf")"
  upstream="$(jq -r '.upstream' "$mf")"
  first_party="$(jq -r '.firstParty' "$mf")"

  git -C "$repo" checkout -q "$branch"

  if [[ "$first_party" == "true" || "$upstream" == "(stock)" ]]; then
    warn "'$id' is first-party; re-seed from stock with 'plugpatcher remove' then 'setup'"
    return 0
  fi

  git -C "$repo" fetch -q origin
  if ! git -C "$repo" "${GIT_ID[@]}" rebase "origin/$ub" >/dev/null 2>&1; then
    git -C "$repo" rebase --abort >/dev/null 2>&1 || true
    notify "PlugPatcher: conflict syncing $id" "Nothing changed. Resolve in $repo"
    die "cannot auto-merge upstream for '$id'; resolve manually in $repo"
  fi

  generate_clone "$id"
  touch_last_sync "$id"
  # A regenerated clone does not always rebuild the live widget/panel from a
  # rescan, so restart the shell to make the change visible.
  schedule_shell_restart
  # Re-assert the clone is the loaded plugin (the original may have been
  # reinstalled while it was patched).
  ensure_active "$id"
  rescan
  write_catalog >/dev/null 2>&1 || true
  notify "PlugPatcher: synced $id" "Rebased on origin/$ub"
  log "synced '$id'"
}

# ---------------------------------------------------------------------- remove

cmd_revert() {
  local id="${1:-}" keep_repo="${2:-}"
  [[ -n "$id" ]] || die "usage: plugpatcher revert <plugin-id>"
  is_setup "$id" || die "'$id' is not set up"
  local mf edit_id kinds
  mf="$(meta_file "$id")"
  edit_id="$(jq -r '.editId' "$mf")"
  kinds="$(jq -r '(.kinds // []) | join(",")' "$(manifest_path "$id")" 2>/dev/null || true)"

  # Tear down the edit artifacts FIRST. The shell toggles below can trigger a
  # plugin reload, which may kill this process mid-run; doing the file cleanup
  # first guarantees the patch is really gone even if that happens.
  if [[ "$keep_repo" == "--keep-repo" ]]; then
    log "kept repository at $(repo_dir "$id")"
  else
    local backup="$STATE_DIR/removed/$id-$(date -u +%Y%m%d%H%M%S)"
    mkdir -p "$(dirname "$backup")"
    [[ -d "$(repo_dir "$id")" ]] && mv "$(repo_dir "$id")" "$backup" && log "repository backed up to $backup"
  fi
  rm -rf "$(plugin_dir "$edit_id")"
  rm -f "$mf"

  # Put the original back (disable the clone restores the source; enable is a
  # belt-and-braces no-op when it is already there).
  omarchy plugin disable "$edit_id" >/dev/null 2>&1 || true
  [[ ",$kinds," == *",bar,"* ]] && omarchy bar use "$id" >/dev/null 2>&1 || true
  omarchy plugin enable "$id" >/dev/null 2>&1 || true

  rescan
  write_catalog >/dev/null 2>&1 || true
  notify "PlugPatcher: reverted $id" "Original plugin restored"
  log "reverted '$id'; original is active again"
}

# Switch between the patched clone and the original (enable/disable only).
# The running shell's config dir (matches omarchy-restart-shell).
shell_config_dir() {
  local p; p="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^OMARCHY_PATH=//p' | tail -1)"
  [[ -n "$p" && -f "$p/shell/shell.qml" ]] || p="/usr/share/omarchy"
  printf '%s/shell' "$p"
}

# Flip a plugin's config entry between its source and clone id while the shell is
# stopped, then start the shell again. A live id flip makes the bar's Repeater
# rebuild, which can segfault quickshell, so the edit happens with it down.
switch_entry_safely() { # source_id clone_id target_id [nonwidget]
  local src="$1" clone="$2" target="$3" nonwidget="${4:-false}"
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
  [[ -f "$cfg" ]] || return 0

  # Run the stop/rewrite/start in a transient unit: this process is a child of
  # the shell when launched from the panel, and killing the shell would kill us
  # before we could start it again. The worker re-checks under a lock, so rapid
  # clicks queue instead of being dropped.
  local self; self="$(readlink -f "${BASH_SOURCE[0]}")"
  if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --user --collect --quiet --unit="plugpatcher-switch-$RANDOM" \
      --setenv="PATH=$PATH" --setenv="HOME=$HOME" \
      --setenv="XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}" \
      --setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$UID}" \
      --setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
      "$self" __switch "$src" "$clone" "$target" "$nonwidget" >/dev/null 2>&1 &
  else
    setsid "$self" __switch "$src" "$clone" "$target" "$nonwidget" </dev/null >/dev/null 2>&1 &
  fi
}

# Detached worker for switch_entry_safely: stop the shell, rewrite the entry,
# start the shell again.
cmd_switch_core() { # source_id clone_id target_id [nonwidget]
  local src="$1" clone="$2" target="$3" nonwidget="${4:-false}"
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"

  mkdir -p "$STATE_DIR"
  exec >>"$(log_file switch)" 2>&1
  echo "=== $(date -Is) switch $src <-> $clone -> $target ==="

  # Never run two switches at once; wait for any in-flight one instead of
  # dropping the click.
  exec 9>"$STATE_DIR/switch.lock" || true
  if ! flock -w 60 9; then echo "another switch is stuck; giving up"; return 0; fi

  # Under the lock: nothing to do means no shell restart at all.
  local needs
  needs="$(python3 - "$src" "$clone" "$target" "$cfg" "$nonwidget" <<'PY'
import json, sys
src, clone, target, path, nonwidget = sys.argv[1:6]
nonwidget = nonwidget == "true"
try: d = json.load(open(path))
except Exception: print("no"); raise SystemExit
pairs = {src, clone}
def stale(seq):
    return any(isinstance(e, dict) and e.get("id") in pairs and e.get("id") != target for e in seq)
bad = False
for sec in (d.get("bar", {}).get("layout", {}) or {}):
    if stale(d["bar"]["layout"][sec]): bad = True
if isinstance(d.get("plugins"), list) and stale(d["plugins"]): bad = True
dis = d.get("disabledPlugins", []) or []
restores = d.get("cloneSourceRestores", []) or []
if target == src:
    if src in dis or clone in restores: bad = True
else:
    if nonwidget and (src not in dis or clone not in restores): bad = True
print("yes" if bad else "no")
PY
)"
  if [[ "$needs" != "yes" ]]; then echo "already on $target; nothing to do"; return 0; fi

  local dir; dir="$(shell_config_dir)"
  command -v quickshell >/dev/null 2>&1 && \
    while timeout 5 quickshell kill -p "$dir" --any-display >/dev/null 2>&1; do :; done

  python3 - "$src" "$clone" "$target" "$cfg" "$nonwidget" <<'PY'
import json, os, sys
src, clone, target, path, nonwidget = sys.argv[1:6]
nonwidget = nonwidget == "true"
try: d = json.load(open(path))
except Exception: raise SystemExit
pairs = {src, clone}
def swap(seq):
    out, seen = [], False
    for e in seq:
        if isinstance(e, dict) and e.get("id") in pairs:
            e = dict(e); e["id"] = target
        if isinstance(e, dict) and e.get("id") == target:
            if seen: continue
            seen = True
        out.append(e)
    return out
for sec in (d.get("bar", {}).get("layout", {}) or {}):
    d["bar"]["layout"][sec] = swap(d["bar"]["layout"][sec])
if isinstance(d.get("plugins"), list):
    d["plugins"] = swap(d["plugins"])

# Omarchy disables the source in disabledPlugins (and records a restore) while
# a clone with non-bar-widget kinds is active. Undo/redo that with the flip.
dis = [x for x in (d.get("disabledPlugins", []) or []) if x not in pairs]
restores = [x for x in (d.get("cloneSourceRestores", []) or []) if x not in pairs]
if target == clone and nonwidget:
    if src not in dis: dis.append(src)
    if clone not in restores: restores.append(clone)
if dis: d["disabledPlugins"] = dis
else: d.pop("disabledPlugins", None)
if restores: d["cloneSourceRestores"] = restores
else: d.pop("cloneSourceRestores", None)

tmp = path + ".pp.tmp"
json.dump(d, open(tmp, "w"), indent=2)
os.replace(tmp, path)
PY

  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    local hd
    hd="$(find "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2-)"
    [[ -n "$hd" ]] && export HYPRLAND_INSTANCE_SIGNATURE="${hd##*/}"
  fi
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-launch-shell")' >/dev/null 2>&1 || true
  else
    setsid omarchy-launch-shell >/dev/null 2>&1 &
  fi

  # Make sure the shell actually came back; if not, fall back to Omarchy's own
  # restart so the user is never left with no bar.
  local i ok=""
  for (( i = 0; i < 60; i++ )); do
    omarchy-shell shell ping >/dev/null 2>&1 && { ok=1; break; }
    sleep 0.25
  done
  if [[ -z "$ok" ]]; then
    echo "shell did not come back; falling back to 'omarchy restart shell'"
    omarchy restart shell >/dev/null 2>&1 || true
    for (( i = 0; i < 120; i++ )); do
      omarchy-shell shell ping >/dev/null 2>&1 && break
      sleep 0.25
    done
  fi
  # Let the fresh shell finish loading plugins before the lock is released and
  # another switch may kill it mid-startup.
  sleep 1.5
  write_catalog >/dev/null 2>&1 || true
}

cmd_use() {
  local id="${1:-}" want="${2:-}"
  [[ -n "$id" ]] || die "usage: plugpatcher use <plugin-id> <patched|original|toggle>"
  is_setup "$id" || die "'$id' is not set up"
  local mf edit_id kinds
  mf="$(meta_file "$id")"
  edit_id="$(jq -r '.editId' "$mf")"
  kinds="$(jq -r '(.kinds // []) | join(",")' "$(manifest_path "$id")" 2>/dev/null || true)"
  # Non-bar-widget kinds (overlay, panel, ...) make Omarchy keep the source in
  # disabledPlugins while the clone is active; the switch must undo that too.
  local nonwidget=false k
  local -a _ka=(); IFS=, read -ra _ka <<< "$kinds"
  for k in "${_ka[@]}"; do [[ -n "$k" && "$k" != "bar-widget" ]] && nonwidget=true; done

  # 'toggle' decides from the live enabled state, not a cached catalog, so a
  # stale button label cannot switch the wrong way.
  if [[ "$want" == "toggle" ]]; then
    local enabled clone_on
    enabled="$(enabled_map)"
    clone_on="$(awk -F '\t' -v e="$edit_id" '$1 == e { print $2 }' <<<"$enabled")"
    [[ "$clone_on" == "true" ]] && want=original || want=patched
  fi

  case "$want" in
    patched)
      touch_want "$id" patched
      if [[ ! -d "$(plugin_dir "$edit_id")" && -d "$(repo_dir "$id")" ]]; then
        generate_clone "$id" >/dev/null 2>&1 || true
      fi
      if [[ ",$kinds," == *",bar,"* ]]; then
        ensure_active "$id"
      elif [[ ",$kinds," == *",bar-widget,"* ]]; then
        # A bar widget reload rebuilds the bar's Repeater, which can crash the
        # shell, so this one goes through the stop/rewrite/start path.
        switch_entry_safely "$id" "$edit_id" "$edit_id" "$nonwidget"
      else
        # Non-bar plugins switch through Omarchy's own API.
        omarchy plugin enable "$edit_id" >/dev/null 2>&1 || true
      fi ;;
    original)
      touch_want "$id" original
      if [[ ",$kinds," == *",bar,"* ]]; then
        set_bar "$id"
        omarchy plugin disable "$edit_id" >/dev/null 2>&1 || true
        omarchy plugin enable "$id" >/dev/null 2>&1 || true
      elif [[ ",$kinds," == *",bar-widget,"* ]]; then
        switch_entry_safely "$id" "$edit_id" "$id" "$nonwidget"
      else
        omarchy plugin disable "$edit_id" >/dev/null 2>&1 || true
        omarchy plugin enable "$id" >/dev/null 2>&1 || true
      fi ;;
    *)
      die "usage: plugpatcher use <plugin-id> <patched|original|toggle>" ;;
  esac

  write_catalog >/dev/null 2>&1 || true
  log "switched '$id' to $want"
}

# Delete one or both sides: original, patched, or both.
cmd_delete() {
  local id="${1:-}" what="${2:-}"
  [[ -n "$id" && "$what" =~ ^(original|patched|both)$ ]] || \
    die "usage: plugpatcher delete <plugin-id> <original|patched|both>"
  is_setup "$id" || die "'$id' is not set up"
  local mf edit_id
  mf="$(meta_file "$id")"
  edit_id="$(jq -r '.editId' "$mf")"

  if [[ "$what" == "original" || "$what" == "both" ]]; then
    if [[ -d "$(plugin_dir "$id")" ]]; then
      omarchy plugin remove "$id" --yes >/dev/null 2>&1 || rm -rf "$(plugin_dir "$id")"
    fi
  fi

  if [[ "$what" == "patched" || "$what" == "both" ]]; then
    omarchy plugin disable "$edit_id" >/dev/null 2>&1 || true
    rm -rf "$(plugin_dir "$edit_id")"
    rm -f "$mf"
    local backup="$STATE_DIR/removed/$id-$(date -u +%Y%m%d%H%M%S)"
    mkdir -p "$(dirname "$backup")"
    [[ -d "$(repo_dir "$id")" ]] && mv "$(repo_dir "$id")" "$backup" || true
  fi

  rescan
  write_catalog >/dev/null 2>&1 || true
  notify "PlugPatcher: deleted $what" "$id"
  log "deleted $what for '$id'"
}

# -------------------------------------------------------------------------- pr

github_slug() { # url -> owner/repo
  local url="$1"
  url="${url%.git}"
  case "$url" in
    git@github.com:*) url="${url#git@github.com:}" ;;
    https://github.com/*) url="${url#https://github.com/}" ;;
    http://github.com/*) url="${url#http://github.com/}" ;;
    *) return 1 ;;
  esac
  printf '%s' "$url"
}

# Ask the system default agent for a PR title and body given a diff.
# Sets PR_TITLE / PR_BODY on success, returns non-zero when no agent can help.
ai_text_for_diff() {
  local diff="$1" agent out="" prompt
  PR_TITLE=""; PR_BODY=""
  agent="$(omarchy-default-agent 2>/dev/null || true)"
  [[ -n "$agent" ]] || return 1
  command -v "$agent" >/dev/null 2>&1 || return 1

  prompt="$(cat <<EOF
You write GitHub pull requests for a local patch to an Omarchy shell plugin.
The repository is the upstream plugin and the diff below is the whole change.

Answer with exactly this format and nothing else:
TITLE: <one concise line>
BODY:
<markdown body: what changed and why>

Diff:
$diff
EOF
)"

  case "$agent" in
    pi)       out="$(timeout 120 pi -p "$prompt" 2>/dev/null || true)" ;;
    claude)   out="$(timeout 120 claude -p "$prompt" 2>/dev/null || true)" ;;
    opencode) out="$(timeout 120 opencode run "$prompt" 2>/dev/null || true)" ;;
    codex)    out="$(timeout 120 codex exec "$prompt" 2>/dev/null || true)" ;;
    gemini)   out="$(timeout 120 gemini -p "$prompt" 2>/dev/null || true)" ;;
    omp)      out="$(timeout 120 omp -p "$prompt" 2>/dev/null || true)" ;;
    *)        return 1 ;;
  esac
  [[ -n "$out" ]] || return 1

  PR_TITLE="$(printf '%s\n' "$out" | sed -n 's/^[Tt][Ii][Tt][Ll][Ee]:[[:space:]]*//p' | head -n1)"
  PR_BODY="$(printf '%s\n' "$out" | awk 'p{print} tolower($0) ~ /^body:[[:space:]]*$/ {p=1}')"
  PR_BODY="$(printf '%s\n' "$PR_BODY" | sed '/./,$!d')"
  [[ -n "$PR_TITLE" ]] || PR_TITLE="$(printf '%s\n' "$out" | head -n1)"
  [[ -n "$PR_BODY" ]] || PR_BODY="$out"
  return 0
}

cmd_pr() {
  local id="${1:-}" mode="${2:-ai}"
  [[ -n "$id" ]] || die "usage: plugpatcher pr <plugin-id> [ai|manual]"
  is_setup "$id" || die "'$id' is not set up"
  case "$mode" in ai|manual) ;; *) die "unknown pr mode '$mode' (use ai or manual)" ;; esac
  need git; need jq
  local mf repo branch ub upstream slug
  mf="$(meta_file "$id")"
  repo="$(require_repo "$id")"
  branch="$(jq -r '.branch' "$mf")"
  ub="$(jq -r '.upstreamBranch' "$mf")"
  upstream="$(jq -r '.upstream' "$mf")"

  slug="$(github_slug "$upstream")" || die "'$id' upstream is not GitHub; push manually from $repo"
  command -v gh >/dev/null 2>&1 || die "gh is not installed"
  gh auth status >/dev/null 2>&1 || die "gh is not authenticated; run: gh auth login"

  local me; me="$(gh api user -q .login)"
  local fork_url="https://github.com/$me/${slug#*/}.git"

  git -C "$repo" remote remove plugpatcher-fork >/dev/null 2>&1 || true
  git -C "$repo" remote add plugpatcher-fork "$fork_url"
  gh repo fork "$slug" --clone=false >/dev/null 2>&1 || true

  # Give each distinct patch its own branch, so a new round of changes opens a
  # new PR instead of failing because an old PR still exists. patch-id is
  # stable across rebases, so the same changes always map to the same branch.
  local remote_branch base pid
  remote_branch="plugpatcher/$id"
  base="$(git -C "$repo" merge-base "$branch" "origin/$ub" 2>/dev/null || true)"
  if [[ -n "$base" ]]; then
    pid="$(git -C "$repo" diff "$base" "$branch" 2>/dev/null | git patch-id --stable 2>/dev/null | awk 'NR==1{print $1}')"
  fi
  [[ -n "$pid" ]] && remote_branch="plugpatcher/$id-${pid:0:10}"

  log "pushing to $me:${slug#*/} ($remote_branch)"
  git -C "$repo" push -q -f -u plugpatcher-fork "$branch:$remote_branch"

  # Manual: just open GitHub's PR form with the branch selected, leaving the
  # title and description for the user to write.
  if [[ "$mode" == "manual" ]]; then
    # Pass empty title/body so GitHub does not pre-fill them from the branch
    # name or the commit list.
    local compare_url="https://github.com/$slug/compare/$ub...$me:$remote_branch?expand=1&title=&body="
    log "opening $compare_url"
    open_url "$compare_url"
    printf '%s\n' "$compare_url"
    return 0
  fi

  # Same patch already reviewed? Point at it rather than failing. gh wants
  # "owner:branch" for cross-repo PRs but a bare branch for same-repo ones.
  local existing
  existing="$(gh pr list --repo "$slug" --head "$me:$remote_branch" --state open --json url --jq '.[0].url // empty' 2>/dev/null || true)"
  [[ -n "$existing" ]] || existing="$(gh pr list --repo "$slug" --head "$remote_branch" --state open --json url --jq '.[0].url // empty' 2>/dev/null || true)"
  if [[ -n "$existing" ]]; then
    log "a pull request for these exact changes already exists: $existing"
    meta_set "$id" lastPr "$existing"
    printf '%s\n' "$existing"
    return 0
  fi

  local diff pr_title pr_body
  diff="$(git -C "$repo" diff "origin/$ub...$branch" 2>/dev/null | head -c 20000 || true)"
  if ai_text_for_diff "$diff"; then
    pr_title="$PR_TITLE"; pr_body="$PR_BODY"
    log "wrote the PR title and description with the default agent"
  else
    warn "no default agent output; using a generic PR description"
    pr_title="$(git -C "$repo" log -1 --format=%s "$branch" 2>/dev/null || true)"
    [[ -n "$pr_title" ]] || pr_title="PlugPatcher changes for $id"
    pr_body="Changes made with PlugPatcher."
  fi
  pr_body="$(printf '%s\n\n---\n_Made with PlugPatcher._\n' "$pr_body")"

  local pr_url
  pr_url="$(gh pr create --repo "$slug" --base "$ub" --head "$me:$remote_branch" \
    --title "$pr_title" --body "$pr_body")" || die "gh pr create failed"
  meta_set "$id" lastPr "$pr_url"
  printf '%s\n' "$pr_url"
}

# Close the open pull request for a plugin's current patch (or the last one
# opened). Never fails when there is nothing to cancel.
cmd_pr_cancel() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: plugpatcher pr-cancel <plugin-id>"
  is_setup "$id" || die "'$id' is not set up"
  need git; need jq; need gh
  local mf repo branch ub upstream slug base pid remote_branch url state
  mf="$(meta_file "$id")"
  repo="$(require_repo "$id")"
  branch="$(jq -r '.branch' "$mf")"
  ub="$(jq -r '.upstreamBranch' "$mf")"
  upstream="$(jq -r '.upstream' "$mf")"
  slug="$(github_slug "$upstream")" || die "'$id' upstream is not GitHub"

  # Same branch naming as `pr`, so we close the PR for the *current* patch.
  remote_branch="plugpatcher/$id"
  base="$(git -C "$repo" merge-base "$branch" "origin/$ub" 2>/dev/null || true)"
  if [[ -n "$base" ]]; then
    pid="$(git -C "$repo" diff "$base" "$branch" 2>/dev/null | git patch-id --stable 2>/dev/null | awk 'NR==1{print $1}')"
  fi
  [[ -n "$pid" ]] && remote_branch="plugpatcher/$id-${pid:0:10}"

  url="$(gh pr list --repo "$slug" --head "$remote_branch" --state open --json url --jq '.[0].url // empty' 2>/dev/null || true)"
  [[ -n "$url" ]] || url="$(jq -r '.lastPr // empty' "$mf" 2>/dev/null || true)"
  if [[ -n "$url" ]]; then
    state="$(gh pr view "$url" --json state --jq .state 2>/dev/null || true)"
    [[ "$state" == "OPEN" ]] || url=""
  fi

  if [[ -z "$url" ]]; then
    log "no open pull request for '$id'"
    printf 'no open pull request for %s\n' "$id"
    return 0
  fi

  gh pr close "$url" --comment "Withdrawn via PlugPatcher." >/dev/null 2>&1 \
    || die "could not close $url"
  meta_set "$id" lastPr ""
  log "closed $url"
  printf 'closed %s\n' "$url"
}

# Open a plugin's upstream (source) page in the browser.
cmd_source() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: plugpatcher source <plugin-id>"
  local src; src="$(source_url_of "$id")" || die "no source URL known for '$id'"
  log "opening $src"
  open_url "$src"
}

# Open an arbitrary URL in the browser (used for the PR link).
cmd_open_url() {
  local url="${1:-}"
  [[ -n "$url" ]] || die "usage: plugpatcher open-url <url>"
  open_url "$url"
}

# Best-effort URL opener: Omarchy's launcher when present, else xdg-open.
open_url() {
  local url="$1"
  if command -v omarchy-launch-browser >/dev/null 2>&1; then
    omarchy-launch-browser "$url" >/dev/null 2>&1 || true
  else
    setsid xdg-open "$url" >/dev/null 2>&1 || true
  fi
}

# ------------------------------------------------------------------------ open

# Read a config value from ~/.config/plugpatcher/config.json.
cfg_get() { jq -r --arg k "$1" '.[$k] // empty' "$CONFIG_FILE" 2>/dev/null || true; }

# Which harness to use when none is configured (or the configured one is gone).
default_harness() {
  if command -v herdr >/dev/null 2>&1; then echo herdr
  elif command -v tmux >/dev/null 2>&1; then echo tmux
  else echo terminal; fi
}

resolve_harness() {
  local h; h="$(cfg_get harness)"
  case "$h" in
    herdr) command -v herdr >/dev/null 2>&1 && echo herdr || default_harness ;;
    tmux)  command -v tmux  >/dev/null 2>&1 && echo tmux  || default_harness ;;
    terminal|custom) echo "$h" ;;
    *) default_harness ;;
  esac
}

# Map an Omarchy agent name to a herdr --kind value (empty when unsupported).
herdr_kind() {
  case "$1" in
    pi) echo pi ;;
    claude) echo claude ;;
    codex) echo codex ;;
    gemini) echo gemini ;;
    cursor-agent|cursor) echo cursor ;;
    omp) echo omp ;;
    opencode) echo opencode ;;
    copilot) echo copilot ;;
    grok) echo grok ;;
    hermes) echo hermes ;;
    *) echo "" ;;
  esac
}

cmd_open() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: plugpatcher open <plugin-id>"
  is_setup "$id" || die "'$id' is not set up for editing (run: plugpatcher setup $id)"
  local repo; repo="$(require_repo "$id")"

  local harness; harness="$(resolve_harness)"
  local custom; custom="$(cfg_get command)"

  case "$harness" in
    custom)
      [[ -n "$custom" ]] || die "no custom command set (plugpatcher config command \"<cmd>\")"
      custom="${custom//\{dir\}/$repo}"
      log "opening custom command: $custom"
      ( cd "$repo" && setsid bash -lc "$custom" >/dev/null 2>&1 & )
      ;;
    tmux)
      command -v tmux >/dev/null 2>&1 || die "tmux is set as the AI harness but is not installed"
      log "opening tmux at: $repo"
      setsid bash -lc "omarchy launch terminal tmux" >/dev/null 2>&1 &
      ;;
    terminal)
      log "opening a terminal at: $repo"
      setsid uwsm-app -- xdg-terminal-exec --dir="$repo" >/dev/null 2>&1 &
      ;;
    *)
      command -v herdr >/dev/null 2>&1 || die "herdr is set as the AI harness but is not installed"
      if herdr status server --json 2>/dev/null | jq -e '.running == true' >/dev/null 2>&1; then
        local created pane agent kind
        created="$(herdr workspace create --cwd "$repo" --label "$id" --focus 2>/dev/null || true)"
        pane="$(jq -r '.result.root_pane.pane_id // empty' <<<"$created" 2>/dev/null || true)"
        agent="$(omarchy-default-agent 2>/dev/null || true)"
        kind="$(herdr_kind "$agent")"
        if [[ -n "$pane" && -n "$kind" ]]; then
          log "starting $agent in the Herdr workspace"
          setsid herdr agent start "$agent" --kind "$kind" --pane "$pane" >/dev/null 2>&1 &
        fi
      fi
      log "opening Herdr at: $repo"
      # Focus an existing Herdr window instead of opening a second one.
      setsid bash -lc "omarchy launch or focus herdr 'omarchy-launch-tui --app-id=org.omarchy.herdr herdr'" >/dev/null 2>&1 &
      ;;
  esac
}

# Open the per-project patch folder in the default file manager.
cmd_open_files() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: plugpatcher files <plugin-id>"
  is_setup "$id" || die "'$id' is not set up for editing (run: plugpatcher setup $id)"
  local repo; repo="$(require_repo "$id")"
  command -v xdg-open >/dev/null 2>&1 || die "xdg-open is not installed (install xdg-utils)"
  log "opening patch folder: $repo"
  setsid xdg-open "$repo" >/dev/null 2>&1 &
}

# Open the per-project patch folder in the default editor.
cmd_open_editor() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: plugpatcher editor <plugin-id>"
  is_setup "$id" || die "'$id' is not set up for editing (run: plugpatcher setup $id)"
  local repo; repo="$(require_repo "$id")"

  command -v omarchy-launch-editor >/dev/null 2>&1 || die "omarchy-launch-editor is not available"

  local editor_file="$HOME/.local/state/omarchy/defaults/editor" editor=""
  [[ -f "$editor_file" ]] && read -r editor < "$editor_file"
  [[ -n "$editor" ]] || editor="nvim"
  command -v "${editor##*/}" >/dev/null 2>&1 || \
    die "default editor '$editor' is not installed (set one with: omarchy default editor <name>)"

  log "opening $editor in: $repo"
  setsid omarchy-launch-editor "$repo" >/dev/null 2>&1 &
}

# ---------------------------------------------------------------------- config

cmd_config() {
  local key="${1:-}" value="${2:-}"
  mkdir -p "$(dirname "$CONFIG_FILE")"
  [[ -f "$CONFIG_FILE" ]] || printf '{}\n' > "$CONFIG_FILE"
  if [[ -z "$key" ]]; then
    cat "$CONFIG_FILE"
    return 0
  fi
  [[ -n "$value" ]] || die "usage: plugpatcher config <key> <value>"
  local tmp; tmp="$(mktemp)"
  if jq --arg k "$key" --arg v "$value" '.[$k] = $v' "$CONFIG_FILE" > "$tmp"; then
    mv "$tmp" "$CONFIG_FILE"
    log "set $key = $value"
  else
    rm -f "$tmp"
    die "could not update $CONFIG_FILE"
  fi
}

# Machine-readable settings for the panel: installed harnesses + models.
cmd_settings() {
  local harness custom
  harness="$(resolve_harness)"; custom="$(cfg_get command)"

  local harnesses='[]'
  command -v herdr >/dev/null 2>&1 && harnesses="$(jq -cn --argjson h "$harnesses" '$h + [{value:"herdr",label:"Herdr"}]')"
  command -v tmux >/dev/null 2>&1 && harnesses="$(jq -cn --argjson h "$harnesses" '$h + [{value:"tmux",label:"tmux"}]')"
  harnesses="$(jq -cn --argjson h "$harnesses" '$h + [{value:"terminal",label:"Terminal"}]')"
  harnesses="$(jq -cn --argjson h "$harnesses" '$h + [{value:"custom",label:"Custom command\u2026"}]')"

  jq -n --arg harness "$harness" --arg command "$custom" --argjson harnesses "$harnesses" \
    '{harness:$harness, command:$command, harnesses:$harnesses}'
}

# ------------------------------------------------------------------ list/status

enabled_map() {
  # NOTE: no -q here — it suppresses stdout, which would make every plugin look
  # disabled (and send heal into a re-enable loop).
  omarchy-shell shell listPlugins 2>/dev/null |
    jq -r '.[] | "\(.id)\t\(.enabled)\t\(.active)"' 2>/dev/null || true
}

write_catalog() {
  mkdir -p "$DATA_DIR"
  local enabled; enabled="$(enabled_map)"
  local entries="[]"
  if command -v omarchy-plugin-catalog >/dev/null 2>&1; then
    local line id name kinds manifest_path generated mf state edit_id upstream branch ub repo_path last_edit last_update
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      id="$(jq -r '.id' <<<"$line")"
      [[ "$id" == omarchy.* ]] && continue
      manifest_path="$(jq -r '.manifestPath // empty' <<<"$line")"
      generated="false"
      [[ -n "$manifest_path" && -f "$manifest_path" ]] && \
        generated="$(jq -r '.plugpatcher.generated // false' "$manifest_path" 2>/dev/null || echo false)"
      # A PlugPatcher-generated clone is an artifact, not a target itself.
      [[ "$generated" == "true" ]] && continue
      name="$(jq -r '.name // .id' <<<"$line")"
      kinds="$(jq -c '.kinds // []' <<<"$line")"
      mf="$(meta_file "$id")"
      local src_url=""
      if [[ -f "$mf" ]]; then
        state="editing"
        edit_id="$(jq -r '.editId' "$mf")"
        upstream="$(jq -r '.upstream' "$mf")"
        branch="$(jq -r '.branch' "$mf")"
        ub="$(jq -r '.upstreamBranch' "$mf")"
        repo_path="$(repo_dir "$id")"
        src_url="$upstream"
        # Last local-only commit = the most recent patch edit.
        last_edit="$(git -C "$repo_path" log -1 --format=%ct "origin/$ub..$branch" 2>/dev/null || true)"
        [[ -n "$last_edit" ]] || last_edit="$(git -C "$repo_path" log -1 --format=%ct "$branch" 2>/dev/null || true)"
        # Last time sync pulled upstream.
        last_update="$(jq -r '.lastSync // empty' "$mf" 2>/dev/null || true)"
      else
        state="original"; edit_id=""; upstream=""; branch=""
        last_edit=""; last_update=""
        # A source URL so untouched plugins can show a Source button too.
        local pdir; pdir="$(plugin_dir "$id")"
        [[ -d "$pdir/.git" ]] && src_url="$(git -C "$pdir" remote get-url origin 2>/dev/null || true)"
        if [[ -z "$src_url" && -n "$manifest_path" && -f "$manifest_path" ]]; then
          src_url="$(jq -r '.homepage // .repository // empty' "$manifest_path" 2>/dev/null || true)"
        fi
      fi
      entries="$(jq -n --argjson e "$entries" \
        --arg id "$id" --arg name "$name" --argjson kinds "$kinds" \
        --arg state "$state" --arg editId "$edit_id" --arg upstream "$upstream" --arg branch "$branch" \
        --arg source "$src_url" \
        --argjson lastEdit "${last_edit:-null}" --argjson lastUpdate "${last_update:-null}" '
        $e + [{id:$id, name:$name, kinds:$kinds, state:$state,
               editId: (if $editId == "" then null else $editId end),
               upstream: (if $upstream == "" then null else $upstream end),
               source: (if $source == "" then null else $source end),
               branch: (if $branch == "" then null else $branch end),
               lastEdit: $lastEdit, lastUpdate: $lastUpdate}]')"
    done < <(omarchy-plugin-catalog 2>/dev/null | jq -c '.[]' 2>/dev/null)

    # PlugPatcher metadata whose original plugin is no longer installed: the
    # clone may still be loaded but there is no source to update from. Surface
    # it so the GUI can show and clean it up.
    local known sid sname sedit mfile
    known="$(jq -r '.[].id' <<<"$entries" 2>/dev/null || true)"
    while IFS= read -r mfile; do
      [[ -n "$mfile" ]] || continue
      sid="$(jq -r '.sourceId // empty' "$mfile" 2>/dev/null || true)"
      [[ -n "$sid" ]] || continue
      grep -qxF "$sid" <<<"$known" && continue
      sname="$(jq -r '.name // .sourceId' "$mfile" 2>/dev/null || echo "$sid")"
      sedit="$(jq -r '.editId // empty' "$mfile" 2>/dev/null || true)"
      entries="$(jq -n --argjson e "$entries" --arg id "$sid" --arg name "$sname" --arg editId "$sedit" '
        $e + [{id:$id, name:$name, kinds:[], state:"orphaned",
               editId: (if $editId == "" then null else $editId end),
               upstream:null, source:null, branch:null, lastEdit:null, lastUpdate:null}]')"
    done < <(find "$DATA_DIR" -mindepth 1 -maxdepth 1 -name '*.json' ! -name 'catalog.json' -print 2>/dev/null)

    entries="$(jq -n --argjson e "$entries" --arg enabled "$enabled" '
      ($enabled | split("\n") | map(select(length>0) | split("\t"))) as $rows
      | $e | map(. as $p
        | (($rows | map(select(.[0]==$p.id)) | .[0]) // []) as $src
        | (($rows | map(select(.[0]==($p.editId // $p.id))) | .[0]) // []) as $cln
        | $p + {
            sourceEnabled: (($src[1] // "false") == "true"),
            cloneEnabled: (($cln[1] // "false") == "true"),
            enabled: (if ($p.editId // null) != null then (($cln[1] // "false") == "true") else (($src[1] // "false") == "true") end),
            active: (if ($p.editId // null) != null then (($cln[2] // "false") == "true") else (($src[2] // "false") == "true") end)
          })
    ' 2>/dev/null || printf '%s' "$entries")"
  fi
  jq -n --argjson plugins "$entries" --arg updatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{version:1, updatedAt:$updatedAt, plugins:$plugins}' > "$CATALOG.tmp"
  mv "$CATALOG.tmp" "$CATALOG"
  printf '%s' "$entries"
}

# Re-assert that every adopted plugin's clone is the one that is enabled. This
# heals the case where the original was removed and reinstalled underneath a
# patch: the clone stays on disk but goes dormant, so the changes vanish.
cmd_heal() {
  need jq
  local enabled; enabled="$(enabled_map)"
  local mfile sid edit_id clone_enabled want
  local -a rebuilt=() activate=()
  while IFS= read -r mfile; do
    [[ -n "$mfile" ]] || continue
    sid="$(jq -r '.sourceId // empty' "$mfile" 2>/dev/null || true)"
    edit_id="$(jq -r '.editId // empty' "$mfile" 2>/dev/null || true)"
    [[ -n "$sid" && -n "$edit_id" ]] || continue
    # Orphaned (original gone): nothing to heal, the panel offers Delete.
    [[ -d "$(plugin_dir "$sid")" ]] || continue
    # The user explicitly chose the original: leave it alone.
    want="$(jq -r '.want // "patched"' "$mfile" 2>/dev/null || echo patched)"
    [[ "$want" == "original" ]] && continue

    if [[ ! -d "$(plugin_dir "$edit_id")" ]]; then
      # Metadata without a clone: rebuild it from the repo.
      if [[ -d "$(repo_dir "$sid")" ]]; then
        log "rebuilding missing clone $edit_id"
        generate_clone "$sid" && rebuilt+=("$sid")
      fi
      continue
    fi
    clone_enabled="$(awk -F '\t' -v id="$edit_id" '$1 == id { print $2 }' <<<"$enabled")"
    [[ "$clone_enabled" != "true" ]] && activate+=("$sid")
  done < <(find "$DATA_DIR" -mindepth 1 -maxdepth 1 -name '*.json' ! -name 'catalog.json' -print 2>/dev/null)

  # A rebuilt clone must be discovered by the shell before it can be enabled.
  if (( ${#rebuilt[@]} )); then
    rescan
    sleep 0.3
    activate+=("${rebuilt[@]}")
  fi

  local s e
  for s in "${activate[@]}"; do
    [[ -n "$s" ]] || continue
    e="$(jq -r '.editId // empty' "$(meta_file "$s")" 2>/dev/null || true)"
    [[ -n "$e" ]] && wait_discovered "$e" 2>/dev/null || true
    log "re-activating $e"
    ensure_active "$s"
  done

  # Always refresh the catalog (a read); only ever poke the shell above, and
  # only when there was something to heal.
  write_catalog >/dev/null 2>&1 || true
}

# Open a terminal and update every plugin with Omarchy's own updater.
cmd_update_all() {
  command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1 || \
    die "omarchy-launch-floating-terminal-with-presentation is not available"
  log "opening a terminal to update all plugins"
  setsid omarchy-launch-floating-terminal-with-presentation "omarchy plugin update --yes" >/dev/null 2>&1 &
}

cmd_list() {
  need jq
  local entries; entries="$(write_catalog)"
  printf '%-40s %-9s %s\n' "PLUGIN" "STATE" "CLONE"
  jq -r '.[] | [.id, .state, (.editId // "-")] | @tsv' <<<"$entries" |
    while IFS=$'\t' read -r id state clone; do
      printf '%-40s %-9s %s\n' "$id" "$state" "$clone"
    done
}

cmd_status() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: plugpatcher status <plugin-id>"
  need jq
  local pd; pd="$(plugin_dir "$id")"
  [[ -d "$pd" || -f "$(manifest_path "$id")" ]] || die "unknown plugin '$id'"
  local name; name="$(jq -r '.name // .id' "$(manifest_path "$id")" 2>/dev/null || echo "$id")"
  printf 'plugin:   %s (%s)\n' "$id" "$name"
  if ! is_setup "$id"; then
    printf 'state:    original (not set up for editing)\n'
    return 0
  fi
  local mf repo branch ub upstream edit_id
  mf="$(meta_file "$id")"; repo="$(repo_dir "$id")"
  branch="$(jq -r '.branch' "$mf")"; ub="$(jq -r '.upstreamBranch' "$mf")"
  upstream="$(jq -r '.upstream' "$mf")"; edit_id="$(jq -r '.editId' "$mf")"
  printf 'state:    editing\n'
  printf 'clone:    %s\n' "$edit_id"
  printf 'repo:     %s\n' "$repo"
  printf 'upstream: %s (%s)\n' "$upstream" "$ub"
  if [[ "$upstream" != "(stock)" && -d "$repo/.git" ]]; then
    git -C "$repo" fetch -q origin 2>/dev/null || true
    local counts; counts="$(git -C "$repo" rev-list --left-right --count "origin/$ub...$branch" 2>/dev/null || echo "0	0")"
    printf 'behind:   %s commit(s) upstream\n' "$(cut -f1 <<<"$counts")"
    printf 'ahead:    %s local commit(s)\n' "$(cut -f2 <<<"$counts")"
    if [[ -n "$(git -C "$repo" status --porcelain)" ]]; then
      printf 'worktree: dirty\n'
    else
      printf 'worktree: clean\n'
    fi
  fi
}

# ------------------------------------------------------------------------ help

usage() {
  cat <<'USAGE'
plugpatcher — patch Omarchy shell plugins in a git repo, pull upstream updates
in with your edits on top, and send them back. The original install is left in
place and keeps updating.

  original plugin   ~/.config/omarchy/plugins/<id>          (pristine install, left in place)
  per-project repo  ~/.local/share/plugpatcher/<id>/        (git clone of upstream + your branch)
  generated clone   ~/.config/omarchy/plugins/local.<seg>/  (what the shell loads)

Commands:
  list                 installed plugins and their edit state
  status <id>          details for one plugin
  setup <id> [url]     start editing (clone upstream into a per-project repo)
  adopt [id]           bring an existing git project under PlugPatcher (keeps history)
  sync <id>            pull upstream into the repo (rebase) and regenerate the clone
  pr <id> [ai|manual]  open a PR: ai writes the text, manual opens GitHub's form
  revert <id>          stop editing: restore the original, delete the clone
  use <id> <side>      switch the loaded plugin: patched | original
  delete <id> <side>   delete original | patched | both
  open <id>            launch the default agent in the repo, resuming its session
  files <id>           open the patch folder in the default file manager
  editor <id>          open the patch folder in the default editor
  config [k] [v]       show or set config (config.json)
  heal                 re-activate adopted clones that went dormant
  update-all           open a terminal and run 'omarchy plugin update --yes'
  pr-cancel <id>       close the pull request most recently opened for <id>
  source <id>          open the plugin's upstream (source) page in the browser
  open-url <url>       open a URL in the browser
  settings             machine-readable settings for the panel (JSON)
  help                 this text
USAGE
}

# ---------------------------------------------------------------------- driver

main() {
  local cmd="${1:-help}"
  shift || true
  git_identity
  case "$cmd" in
    list)         cmd_list "$@" ;;
    status)       cmd_status "$@" ;;
    setup)        cmd_setup "$@" ;;
    adopt)        cmd_adopt "$@" ;;
    __switch)     cmd_switch_core "$@" ;;
    sync)         cmd_sync "$@" ;;
    pr)           cmd_pr "$@" ;;
    revert|remove|rm) cmd_revert "$@" ;;
    use|switch)   cmd_use "$@" ;;
    delete|del)   cmd_delete "$@" ;;
    open)         cmd_open "$@" ;;
    files)        cmd_open_files "$@" ;;
    editor)       cmd_open_editor "$@" ;;
    config)       cmd_config "$@" ;;
    heal)         cmd_heal "$@" ;;
    update-all)   cmd_update_all "$@" ;;
    pr-cancel|unpr|cancel-pr) cmd_pr_cancel "$@" ;;
    source)       cmd_source "$@" ;;
    open-url)     cmd_open_url "$@" ;;
    settings)     cmd_settings "$@" ;;
    help|-h|--help) usage ;;
    version|--version) echo "plugpatcher $VERSION" ;;
    *) die "unknown command '$cmd' (try: plugpatcher help)" ;;
  esac
}

main "$@"
